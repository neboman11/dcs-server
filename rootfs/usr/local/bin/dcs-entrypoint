#!/usr/bin/env bash
# Headless X + noVNC, Wine prefix bootstrap, DCS install/update, and server supervision.
set -Eeuo pipefail

: "${DCS_MODE:=server}"              # server | benchmark | desktop
: "${DCS_WRITEDIR:=DCS.server}"      # Saved Games writedir name (DCS_server.exe -w)
: "${DCS_TERRAINS:=CAUCASUS_terrain}"
: "${DCS_AUTO_UPDATE:=false}"        # run DCS_updater.exe update on every start
: "${DCS_DESANITIZE:=}"              # Lua modules to un-sanitize, e.g. "io lfs" for Liberation/DCC
: "${DCS_SERVER_NAME:=}"
: "${DCS_SERVER_PASSWORD:=}"
: "${DCS_MAX_PLAYERS:=}"
: "${VNC_PASSWORD:?VNC_PASSWORD must be set}"
: "${SCREEN_GEOMETRY:=1280x800x24}"

DCS_UPDATER_URL=https://cdn.digitalcombatsimulator.com/files/DCS_updater_64bit.zip
DRIVE_C=$WINEPREFIX/drive_c
SRV=$DRIVE_C/DCS_server
CFG=$DRIVE_C/DCS_configs

pids=()
server_pid=

log() { printf '[dcs-entrypoint] %s\n' "$*"; }

cleanup() {
  log "shutting down"
  if [[ -n $server_pid ]] && kill -0 "$server_pid" 2>/dev/null; then
    # the watchdog closes DCS gracefully (WM_CLOSE) on SIGTERM
    kill -TERM "$server_pid" 2>/dev/null || true
    wait "$server_pid" 2>/dev/null || true
  fi
  wineserver -k 2>/dev/null || true
  kill "${pids[@]}" 2>/dev/null || true
  exit 0
}
trap cleanup TERM INT

start_display() {
  rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
  Xvfb :0 -screen 0 "$SCREEN_GEOMETRY" -nolisten tcp &
  pids+=($!)
  for _ in $(seq 100); do [[ -S /tmp/.X11-unix/X0 ]] && break; sleep 0.1; done
  [[ -S /tmp/.X11-unix/X0 ]] || { log "Xvfb failed to start"; exit 1; }
  openbox &
  pids+=($!)
  x11vnc -storepasswd "$VNC_PASSWORD" "$HOME/.vncpass" >/dev/null 2>&1
  x11vnc -display :0 -localhost -rfbport 5900 -rfbauth "$HOME/.vncpass" -forever -shared -quiet &
  pids+=($!)
  PYTHONPATH=/opt/websockify python3 -W ignore -m websockify --web /opt/novnc 6080 localhost:5900 >/dev/null 2>&1 &
  pids+=($!)
  log "noVNC listening on :6080"
}

init_prefix() {
  mkdir -p "$WINEPREFIX"
  if [[ ! -f $WINEPREFIX/system.reg ]]; then
    log "initializing wine prefix"
    WINEDLLOVERRIDES="mscoree,mshtml=" wineboot --init
    wineserver -w
  fi
  # one persistent wineserver shared by updater, server, and helper invocations
  wineserver -p
  cp /opt/dcs/wineconfig.reg "$DRIVE_C/wineconfig.reg"
  wine reg import 'C:\wineconfig.reg' >/dev/null 2>&1
  # hardening (as upstream): no host filesystem (Z:) or serial ports inside Wine
  rm -f "$WINEPREFIX"/dosdevices/{z:,com1,com2,com3,com4}
}

ensure_writedir() {
  local name=$1 template=$2
  mkdir -p "$CFG"
  if [[ ! -d $CFG/$name ]]; then
    cp -a "$template" "$CFG/$name"
    log "created writedir $name from $template"
  fi
  local saved="$DRIVE_C/users/$USER/Saved Games"
  if [[ ! -L $saved ]]; then
    mkdir -p "$(dirname "$saved")"
    [[ -d $saved ]] && rmdir "$saved"
    ln -sT ../../DCS_configs "$saved"
  fi
}

wait_for_updater() {
  # the updater re-launches itself from %TEMP%; wait for every copy to exit
  while pgrep -f 'DCS_updater.exe' >/dev/null; do sleep 5; done
}

dcs_updater() {
  (cd "$SRV" && wine bin/DCS_updater.exe --quiet "$@") || log "DCS_updater.exe $* exited with $?"
  wait_for_updater
}

install_or_update() {
  mkdir -p "$SRV/bin" "$SRV/Config"
  if [[ ! -f $SRV/bin/DCS_updater.exe ]]; then
    log "downloading DCS updater"
    curl -fsSL -o /tmp/dcs_updater.zip "$DCS_UPDATER_URL"
    unzip -oq /tmp/dcs_updater.zip -d "$SRV/bin"
    rm /tmp/dcs_updater.zip
  fi
  printf 'EN' >"$SRV/Config/lang.txt"
  printf 'dcs_server.release' >"$SRV/dcs_variant.txt"

  if [[ ! -f $SRV/autoupdate.cfg ]]; then
    # "launch": null keeps the updater from starting the server itself
    # shellcheck disable=SC2086
    python3 - "$SRV/autoupdate.cfg" $DCS_TERRAINS <<'PY'
import json, sys
modules = ["WWII-ARMOUR", "SUPERCARRIER", "WORLD", *sys.argv[2:]]
cfg = {"WARNING": "DO NOT EDIT this file. You may break your install!",
       "branch": "dcs_server.release", "arch": "x86_64", "lang": "EN",
       "modules": modules, "launch": None}
with open(sys.argv[1], "w") as fh:
    json.dump(cfg, fh, indent=1)
PY
  fi

  if [[ ! -f $SRV/bin/DCS_server.exe ]]; then
    log "installing DCS server with: $DCS_TERRAINS (tens of GB; follow progress in noVNC)"
    dcs_updater update
    [[ -f $SRV/bin/DCS_server.exe ]] || { log "install did not produce DCS_server.exe"; exit 1; }
    return
  fi

  local missing
  # shellcheck disable=SC2086
  missing=$(python3 - "$SRV/autoupdate.cfg" $DCS_TERRAINS <<'PY'
import json, sys
have = set(json.load(open(sys.argv[1]))["modules"])
print(" ".join(m for m in sys.argv[2:] if m not in have))
PY
)
  if [[ -n $missing ]]; then
    log "installing modules: $missing"
    # shellcheck disable=SC2086
    dcs_updater install $missing
  fi
  if [[ $DCS_AUTO_UPDATE == true ]]; then
    log "updating DCS"
    dcs_updater update
  fi
}

apply_patches() {
  local ms=$SRV/Scripts/MissionScripting.lua
  [[ -f $ms ]] || return 0
  # updates overwrite MissionScripting.lua, so (re)apply on every start
  patch -d "$SRV" -p0 --forward --batch --reject-file=- -i /opt/dcs/patches/01_MissionScripting.lua.patch >/dev/null || true
  sed -i -E 's/^([[:space:]]*)-- dcs-desanitize: /\1/' "$ms"
  local mod
  for mod in $DCS_DESANITIZE; do
    sed -i -E "s/^([[:space:]]*)(sanitizeModule\('${mod}'\))/\1-- dcs-desanitize: \2/" "$ms"
  done
  [[ -n $DCS_DESANITIZE ]] && log "WARNING: mission scripting un-sanitized for: $DCS_DESANITIZE (run trusted missions only)"
  return 0
}

apply_server_settings() {
  python3 - "$CFG/$DCS_WRITEDIR/Config/serverSettings.lua" <<'PY'
import os, re, sys
path = sys.argv[1]
text = open(path, encoding="utf-8").read()
def lua_str(v):
    return '"' + v.replace("\\", "\\\\").replace('"', '\\"') + '"'
for key, env, conv in (("name", "DCS_SERVER_NAME", lua_str),
                       ("password", "DCS_SERVER_PASSWORD", lua_str),
                       ("maxPlayers", "DCS_MAX_PLAYERS", lambda v: str(int(v)))):
    value = os.environ.get(env)
    if not value:
        continue
    text, n = re.subn(r'(\["%s"\]\s*=\s*)[^\n]*?,' % key,
                      lambda m: m.group(1) + conv(value) + ",", text, count=1)
    if n != 1:
        sys.exit(f"serverSettings.lua: key {key!r} not found")
with open(path, "w", encoding="utf-8") as fh:
    fh.write(text)
PY
}

run_server() {
  cd "$SRV"
  while true; do
    dcs-server-watchdog "$DCS_WRITEDIR" &
    server_pid=$!
    wait "$server_pid" || true
    server_pid=
    log "DCS server exited; restarting in 10s"
    sleep 10 &
    wait $!
  done
}

run_benchmark() {
  ensure_writedir DCS.benchmark /opt/dcs/DCS_benchmark
  # reuse the saved login of the main writedir
  if [[ -f $CFG/$DCS_WRITEDIR/Config/network.vault ]]; then
    cp "$CFG/$DCS_WRITEDIR/Config/network.vault" "$CFG/DCS.benchmark/Config/network.vault"
  fi
  export BENCHMARK_MISSION=${BENCHMARK_MISSION:-Benchmark_100_v2025.04.27.miz}
  export BENCHMARK_ROUNDS=${BENCHMARK_ROUNDS:-3}
  export BENCHMARK_RUNTIME=${BENCHMARK_RUNTIME:-180}
  # shellcheck source=/dev/null
  OS_NAME="$(. /etc/os-release && echo "$PRETTY_NAME") (container)"
  OS_VERSION=$(uname -srv)
  WINE_VERSION=$(wine --version)
  CPU_NAME=$(grep -m1 '^model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ //')
  export OS_NAME OS_VERSION WINE_VERSION CPU_NAME
  export PROC_PRIORITY="SCHED_OTHER nice=0" VIRTUALIZATION=container TACVIEW_ENABLE=0
  log "benchmark: $BENCHMARK_MISSION, $BENCHMARK_ROUNDS x ${BENCHMARK_RUNTIME}s"
  cd "$SRV"
  wine bin/DCS_server.exe -w DCS.benchmark &
  server_pid=$!
  wait "$server_pid" || true
  server_pid=
  log "benchmark finished; results in $CFG/DCS.benchmark/Logs/Benchmark-*.log"
  sleep infinity &
  wait $!
}

main() {
  log "mode=$DCS_MODE $(wine --version)"
  if [[ -r /dev/ntsync && -w /dev/ntsync ]]; then
    log "ntsync: /dev/ntsync available"
  else
    log "ntsync: /dev/ntsync NOT available (falling back to wineserver sync)"
  fi
  start_display
  init_prefix
  ensure_writedir "$DCS_WRITEDIR" /opt/dcs/DCS_defaults

  case $DCS_MODE in
    desktop)
      log "desktop mode: display and noVNC only"
      sleep infinity &
      wait $!
      ;;
    server|benchmark)
      install_or_update
      apply_patches
      apply_server_settings
      if [[ $DCS_MODE == benchmark ]]; then run_benchmark; else run_server; fi
      ;;
    *)
      log "unknown DCS_MODE=$DCS_MODE"
      exit 1
      ;;
  esac
}

main "$@"
