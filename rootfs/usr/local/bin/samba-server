#!/usr/bin/env bash
# LAN SMB share of the DCS writedir (Missions, Tacview, Liberation/DCC state) for desktop tools.
# Runs as root only to authenticate; all file access is forced to the dcs user (uid 1000).
set -Eeuo pipefail
: "${WINEPREFIX:=/data/wine}"
: "${DCS_WRITEDIR:=DCS.server}"
: "${SMB_USER:=dcs}"
: "${SMB_PASSWORD:?SMB_PASSWORD must be set}"

share=$WINEPREFIX/drive_c/DCS_configs/$DCS_WRITEDIR
mkdir -p /run/samba /var/lib/samba/private /var/cache/samba /var/log/samba
cat > /etc/samba/smb.conf <<EOF
[global]
  server role = standalone server
  workgroup = WORKGROUP
  server min protocol = SMB2_10
  smb ports = 445
  disable netbios = yes
  map to guest = never
  load printers = no
  printing = bsd
  printcap name = /dev/null
  disable spoolss = yes
  log file = /dev/stdout
  log level = 1
  # Wine/DCS create files with uid 1000; keep everything owned by it.
  force user = dcs
  force group = dcs
  create mask = 0664
  directory mask = 0775

[dcs]
  path = ${share}
  valid users = ${SMB_USER}
  read only = no
  browseable = yes
  # DCS and Liberation rely on case-insensitive Windows paths.
  case sensitive = no
  preserve case = yes
EOF

id "$SMB_USER" >/dev/null 2>&1 || useradd --no-create-home --shell /usr/bin/nologin --gid dcs "$SMB_USER"
printf '%s\n%s\n' "$SMB_PASSWORD" "$SMB_PASSWORD" | smbpasswd -s -a "$SMB_USER" >/dev/null
printf '[samba-server] sharing %s as \\\\<host>\\dcs for user %s\n' "$share" "$SMB_USER"
exec smbd --foreground --no-process-group --debug-stdout
